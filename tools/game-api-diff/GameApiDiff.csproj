<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Dumps every type, field, property, and method of an Il2CppInterop assembly as
    sorted text so two game builds can be compared with a plain diff. Pass
    "-callers" as the second argument to append each method's native caller count
    (from Il2CppInterop's CallerCount attribute); a hooked method whose count drops
    to zero is no longer called by the game.

      dotnet run -c Release (then, after a double dash) "<game>\BepInEx\interop\Assembly-CSharp.dll" > new.txt

    Mono.Cecil is taken from the game's BepInEx\core folder. Set ER2_GAME_DIR or
    pass /p:ER2GameDir=... when the game is not in the default location.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ER2GameDir Condition="'$(ER2GameDir)' == '' and '$(ER2_GAME_DIR)' != ''">$(ER2_GAME_DIR)</ER2GameDir>
    <ER2GameDir Condition="'$(ER2GameDir)' == ''">E:\SteamLibrary\steamapps\common\Easy Red 2</ER2GameDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Mono.Cecil"><HintPath>$(ER2GameDir)\BepInEx\core\Mono.Cecil.dll</HintPath></Reference>
  </ItemGroup>
</Project>
