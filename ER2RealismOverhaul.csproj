<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="Version.props" />

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>10.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>ER2RealismOverhaul</AssemblyName>
    <RootNamespace>ER2RealismOverhaul</RootNamespace>
    <Version>$(ModVersion)</Version>
    <AssemblyVersion>$(ModVersion).0</AssemblyVersion>
    <FileVersion>$(ModVersion).0</FileVersion>
    <ER2GameDir Condition="'$(ER2GameDir)' == '' and '$(ER2_GAME_DIR)' != ''">$(ER2_GAME_DIR)</ER2GameDir>
    <BepInExCore>$(ER2GameDir)\BepInEx\core</BepInExCore>
    <ER2Interop>$(ER2GameDir)\BepInEx\interop</ER2Interop>
  </PropertyGroup>

  <ItemGroup>
    <!-- Local reverse-engineering scratch projects are not part of the plugin. -->
    <Compile Remove="_inspect\**\*.cs" />
    <!-- Timestamped recovery snapshots are not plugin source. -->
    <Compile Remove="backups\**\*.cs" />
    <!-- The package-free deterministic scenario runner links the planner separately. -->
    <Compile Remove="tests\**\*.cs" />
    <Reference Include="0Harmony"><HintPath>$(BepInExCore)\0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="BepInEx.Core"><HintPath>$(BepInExCore)\BepInEx.Core.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="BepInEx.Unity.Common"><HintPath>$(BepInExCore)\BepInEx.Unity.Common.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="BepInEx.Unity.IL2CPP"><HintPath>$(BepInExCore)\BepInEx.Unity.IL2CPP.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Il2CppInterop.Common"><HintPath>$(BepInExCore)\Il2CppInterop.Common.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Il2CppInterop.Runtime"><HintPath>$(BepInExCore)\Il2CppInterop.Runtime.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Assembly-CSharp"><HintPath>$(ER2Interop)\Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="com.rlabrecque.steamworks.net"><HintPath>$(ER2Interop)\com.rlabrecque.steamworks.net.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Il2Cppmscorlib"><HintPath>$(ER2Interop)\Il2Cppmscorlib.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Photon3Unity3D"><HintPath>$(ER2Interop)\Photon3Unity3D.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="PhotonRealtime"><HintPath>$(ER2Interop)\PhotonRealtime.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="PhotonUnityNetworking"><HintPath>$(ER2Interop)\PhotonUnityNetworking.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.RenderPipelines.Core.Runtime"><HintPath>$(ER2Interop)\Unity.RenderPipelines.Core.Runtime.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.RenderPipelines.Universal.Runtime"><HintPath>$(ER2Interop)\Unity.RenderPipelines.Universal.Runtime.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(ER2Interop)\UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.AnimationModule"><HintPath>$(ER2Interop)\UnityEngine.AnimationModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.AudioModule"><HintPath>$(ER2Interop)\UnityEngine.AudioModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(ER2Interop)\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.IMGUIModule"><HintPath>$(ER2Interop)\UnityEngine.IMGUIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.InputSystem"><HintPath>$(ER2Interop)\Unity.InputSystem.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.InputLegacyModule"><HintPath>$(ER2Interop)\UnityEngine.InputLegacyModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.ParticleSystemModule"><HintPath>$(ER2Interop)\UnityEngine.ParticleSystemModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.PhysicsModule"><HintPath>$(ER2Interop)\UnityEngine.PhysicsModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.TextRenderingModule"><HintPath>$(ER2Interop)\UnityEngine.TextRenderingModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.TerrainModule"><HintPath>$(ER2Interop)\UnityEngine.TerrainModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.TerrainPhysicsModule"><HintPath>$(ER2Interop)\UnityEngine.TerrainPhysicsModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UI"><HintPath>$(ER2Interop)\UnityEngine.UI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UIModule"><HintPath>$(ER2Interop)\UnityEngine.UIModule.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <Target Name="ValidateER2GameDir" BeforeTargets="ResolveReferences"
          Condition="'$(ER2GameDir)' == '' or !Exists('$(ER2GameDir)')">
    <Error Text="Set ER2_GAME_DIR to the Easy Red 2 installation directory, or pass /p:ER2GameDir=&quot;path&quot;." />
  </Target>

  <Target Name="ValidateModVersion" BeforeTargets="PrepareForBuild"
          Condition="'$(ModVersion)' == ''">
    <Error Text="Version.props must define ModVersion." />
  </Target>

  <Target Name="GenerateModVersionSource" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <GeneratedModVersionFile>$(IntermediateOutputPath)ModVersion.g.cs</GeneratedModVersionFile>
    </PropertyGroup>
    <WriteLinesToFile
      File="$(GeneratedModVersionFile)"
      Lines="namespace ER2RealismOverhaul%3B internal static class ModVersionInfo { public const string Value = &quot;$(ModVersion)&quot;%3B }"
      Overwrite="true"
      Encoding="UTF-8" />
    <ItemGroup>
      <Compile Include="$(GeneratedModVersionFile)" />
    </ItemGroup>
  </Target>
</Project>
